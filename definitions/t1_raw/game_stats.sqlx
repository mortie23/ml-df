config {
  hasOutput: true,
  type: "operations",
  schema: dataform.projectConfig.vars.layer_ref,
}

js {
  const bucket_ref = env.replaceEnv(dataform.projectConfig.vars.bucket_raw, dataform.projectConfig.vars.env)
}

load data overwrite ${ self() } (
  game_team_id INT64,
  game_id INT64,
  team_id INT64,
  total_first_downs INT64,
  passing_first_downs INT64,
  rushing_first_downs INT64,
  penalty_first_downs INT64,
  third_down_attempts INT64,
  third_down_conversions INT64,
  third_down_conversion_perc NUMERIC,
  third_down_passing_conversions INT64,
  third_down_rushing_conversions INT64,
  third_down_penalty_conversions INT64,
  fourth_down_attempts INT64,
  fourth_down_conversions INT64,
  fourth_down_conversion_perc NUMERIC,
  fourth_down_passing_conversions INT64,
  fourth_down_rushing_conversions INT64,
  fourth_down_penalty_conversions INT64,
  total_plays INT64,
  total_yards INT64,
  yards_per_play NUMERIC,
  rushing_plays INT64,
  rushing_yards INT64,
  rushing_yards_per_play NUMERIC,
  passing_plays INT64,
  passing_completions INT64,
  passing_yards_per_play NUMERIC,
  interceptions INT64,
  sacks INT64,
  net_passing_yards INT64,
  gross_passing_yards INT64,
  sack_yards INT64,
  total_return_yards INT64,
  punt_returns INT64,
  punt_return_yards INT64,
  kick_off_returns INT64,
  kick_off_return_yards INT64,
  interception_returns INT64,
  interception_return_yards INT64,
  kick_offs INT64,
  kick_offs_in_endzone INT64,
  touchbacks INT64,
  punts INT64,
  average_punt_yards NUMERIC,
  punts_blocked INT64,
  average_net_punt_yards NUMERIC,
  penalties INT64,
  penalty_yards INT64,
  fumbles INT64,
  fumbles_lost INT64,
  total_td INT64,
  passing_td INT64,
  rushing_td INT64,
  interception_td INT64,
  fumble_td INT64,
  punt_return_td INT64,
  kick_off_return_td INT64,
  field_goal_return_td INT64,
  extra_point_attempts INT64,
  extra_points_made INT64,
  extra_points_blocked INT64,
  two_point_conversion_attempts INT64,
  two_point_conversions_made INT64,
  field_goal_attempts INT64,
  field_goals_made INT64,
  field_goals_blocked INT64,
  redzone_visits INT64,
  redzone_td INT64,
  redzone_efficiency NUMERIC,
  goal_to_go_attempts INT64,
  goal_to_go_td INT64,
  goal_to_go_efficiency INT64,
  safeties INT64,
  turnovers INT64,
  points_scored INT64,
  time_of_possesion STRING,
  win_loss STRING,
  created_date TIMESTAMP,
  create_user STRING
)
from files (
  format = "CSV",
  skip_leading_rows = 1,
  uris = ["gs://${ bucket_ref }/game_stats.csv"]
);